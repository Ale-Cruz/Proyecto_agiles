DB_NAME=sistema_pedidos
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Generar una clave aleatoria propia de 64 caracteres; no compartir el .env.
API_SECRET_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 0 conserva las sesiones hasta logout o cambio de contraseña.
SESSION_DAYS=0
CANCEL_ALLOWED_STATES=en_preparacion
# Vacío: generar URLs de fotos con el origen de la petición.
PUBLIC_BASE_URL=
# Por defecto usa ../pagina_web/media; en VPS configurar la ruta compartida.
# MEDIA_ROOT=/srv/cafeteria/media
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
