# Copiar como .env; usar una clave distinta en la VPS.
DJANGO_SECRET_KEY=cambiar-por-una-clave-aleatoria-larga
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_NAME=sistema_pedidos
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# En produccion: DEBUG=0, dominio real, HTTPS y usuario MySQL limitado.
# Activar solo si un proxy de confianza reemplaza X-Forwarded-Proto.
DJANGO_TRUST_PROXY=0
